# EmailJS Configuration
# Create an account at https://dashboard.emailjs.com/
# Add a Service (Gmail) -> VITE_EMAILJS_SERVICE_ID
# Create a Template -> VITE_EMAILJS_TEMPLATE_ID
# Get Public Key from Account Settings -> VITE_EMAILJS_PUBLIC_KEY

VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
